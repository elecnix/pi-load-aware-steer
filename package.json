  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/signals.test.ts test/load.test.ts test/memory.test.ts test/extension.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
